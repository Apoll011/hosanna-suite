{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*", "!.env.example"],
      "outputs": ["dist/**", ".output/**", "build/**", ".next/**"],
      "env": [
        "VITE_*",
        "DATABASE_*",
        "DB_POOL_MAX",
        "DIRECT_URL",
        "BETTER_AUTH_*",
        "STRIPE_*",
        "SUPABASE_*",
        "RESEND_*",
        "EMAIL_FROM",
        "GOOGLE_*",
        "TURNSTILE_*",
        "CORS_*",
        "PUBLIC_APP_URL",
        "AUTH_URL",
        "STUDIO_URL",
        "MCP_RESOURCE_URL",
        "REDIS_URL",
        "NEXT_PUBLIC_*",
        "SKIP_ENV_VALIDATION",
        "PORT"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "fix": {
      "cache": false
    }
  }
}
