{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hosanna-saas",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "hosanna.live",
      "custom_domain": true,
    },
    // www.hosanna.live already has DNS A/CNAME records managed outside
    // Workers custom domains — attach/redirect that hostname in the CF dashboard.
  ],
}
