{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "hosanna.live",
      "custom_domain": true,
    },
    {
      "pattern": "www.hosanna.live",
      "custom_domain": true,
    },
  ],
}
