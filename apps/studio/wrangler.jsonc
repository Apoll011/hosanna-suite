{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Preview / develop deploy — production (studio.hosanna.live) comes later.
  "routes": [
    {
      "pattern": "dev-studio.hosanna.live",
      "custom_domain": true,
    },
  ],
}
