{
  "name": "@hosanna/api",
  "version": "2.24.5",
  "license": "Apache-2.0",
  "description": "Production REST API backend for Hosanna Studio (songs, folders, services, musician access)",
  "main": "dist/index.mjs",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:mcp-docs",
    "build:mcp-docs": "mkdir -p dist/mcp/docs && cp -R docs/mcp/. dist/mcp/docs/",
    "start": "node dist/index.mjs",
    "dev": "tsx watch src/index.mts",
    "mcp": "tsx src/mcp/stdio.ts",
    "test": "tsx --import ./test/setup-env.ts --test \"test/**/*.test.ts\"",
    "prisma:generate": "pnpm --filter @hosanna/db db:generate",
    "prisma:migrate": "pnpm --filter @hosanna/db db:migrate",
    "prisma:migrate:dev": "pnpm --filter @hosanna/db db:migrate:dev",
    "prisma:push": "pnpm --filter @hosanna/db db:push",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "node ../../scripts/generate-openapi.mjs && pnpm --filter @hosanna/types generate",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/openai": "^4.0.105",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@hosanna/auth": "workspace:*",
    "@hosanna/cache": "workspace:*",
    "@hosanna/chordpro": "workspace:*",
    "@hosanna/db": "workspace:*",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@vercel/functions": "^3.9.9",
    "@vercel/related-projects": "^1.1.1",
    "ai": "^7.0.157",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "jose": "^6.2.14",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hosanna/config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.19.0",
    "typescript": "catalog:"
  }
}
