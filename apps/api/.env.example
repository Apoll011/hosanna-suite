# --- Database ----------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173
# RATE_LIMIT_DISABLED=true
# DB_POOL_MAX=5

# --- Public / Auth -----------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000
# Auth app origin (Better Auth baseURL / issuer). On Vercel, relatedProjects
# resolve the matching hosanna-auth deploy.
AUTH_URL=http://localhost:5174
STUDIO_URL=https://studio.hosanna.live
# MCP_RESOURCE_URL=http://127.0.0.1:3000/mcp
# Optional Better Auth bearer for local MCP stdio (`pnpm mcp`)
# HOSANNA_BEARER_TOKEN=

# Same secret as apps/auth — slim createAuth (getSession + inbox + JWKS).
BETTER_AUTH_SECRET=

# --- Cache -------------------------------------------------------------------
# Unset = in-process Keyv memory (@hosanna/cache). Set to use Redis (shared with auth).
# REDIS_URL=redis://127.0.0.1:6379

# --- Optional ----------------------------------------------------------------
# AI_SETTINGS_ENCRYPTION_KEY=
# YOUTUBE_API_KEY=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# CRON_SECRET=
