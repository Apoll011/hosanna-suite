			"version": 2,
			"versionNonce": 1620006049,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794093214336,
			"link": null,
			"locked": false,
			"text": "1  Client sends its checkpoint\n    { updatedAt, id } + limit (about 100)\n\n2  Server returns documents changed\n    after the checkpoint (active org only)\n\n3  Client upserts docs or applies\n    tombstones, then advances checkpoint\n\n4  syncCache may skip the DB when the\n    tenant has no new changes\n\nOrder in Studio: services before\nagendaEvents (dependency)",
			"fontSize": 17,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1  Client sends its checkpoint\n    { updatedAt, id } + limit (about 100)\n\n2  Server returns documents changed\n    after the checkpoint (active org only)\n\n3  Client upserts docs or applies\n    tombstones, then advances checkpoint\n\n4  syncCache may skip the DB when the\n    tenant has no new changes\n\nOrder in Studio: services before\nagendaEvents (dependency)",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "al",
			"created": null,
