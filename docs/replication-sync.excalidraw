			"isDeleted": false,
			"boundElements": [],
			"updated": 1794093214336,
			"link": null,
			"locked": false,
			"text": "1  Client sends changeRows with\n    assumedMasterState\n\n2  Requires an active subscription\n\n3  Server applies the change, or\n    returns a conflict\n\n4  Conflict: server master wins, the\n    client overwrites its local copy\n\n5  Studio sends partial field diffs;\n    Flutter marks pushed rows clean\n\nLock identity: (id, updatedAt)",
			"fontSize": 17,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1  Client sends changeRows with\n    assumedMasterState\n\n2  Requires an active subscription\n\n3  Server applies the change, or\n    returns a conflict\n\n4  Conflict: server master wins, the\n    client overwrites its local copy\n\n5  Studio sends partial field diffs;\n    Flutter marks pushed rows clean\n\nLock identity: (id, updatedAt)",
			"autoResize": true,
			"lineHeight": 1.25,
