      "seed": 739686957,
      "version": 2,
      "versionNonce": 2048509123,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794750528328,
      "link": null,
      "locked": false,
      "text": "Studio build:   VITE_API_URL, VITE_AUTH_URL, VITE_TURNSTILE_SITE_KEY, VITE_PUBLIC_POSTHOG_*\nMarketing build:   VITE_DASHBOARD_URL = auth host, VITE_API_URL (plan prices)\nAuth service:   AUTH_URL, NEXT_PUBLIC_AUTH_URL, BETTER_AUTH_SECRET, DATABASE_URL,\n                Google, Stripe, Turnstile, Resend, Supabase\nAPI service:   AUTH_URL (issuer + JWKS), DATABASE_URL, DIRECT_URL, STUDIO_URL,\n                MCP_RESOURCE_URL, CRON_SECRET, FCM_*, AI_SETTINGS_ENCRYPTION_KEY\nFlutter:   --dart-define HOSANNA_AUTH_URL, captcha page on the auth host\nRedis Cloud URL: set on auth + API (variable name is not in the repo yet)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Studio build:   VITE_API_URL, VITE_AUTH_URL, VITE_TURNSTILE_SITE_KEY, VITE_PUBLIC_POSTHOG_*\nMarketing build:   VITE_DASHBOARD_URL = auth host, VITE_API_URL (plan prices)\nAuth service:   AUTH_URL, NEXT_PUBLIC_AUTH_URL, BETTER_AUTH_SECRET, DATABASE_URL,\n                Google, Stripe, Turnstile, Resend, Supabase\nAPI service:   AUTH_URL (issuer + JWKS), DATABASE_URL, DIRECT_URL, STUDIO_URL,\n                MCP_RESOURCE_URL, CRON_SECRET, FCM_*, AI_SETTINGS_ENCRYPTION_KEY\nFlutter:   --dart-define HOSANNA_AUTH_URL, captcha page on the auth host\nRedis Cloud URL: set on auth + API (variable name is not in the repo yet)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ao"
    },
