STILE_SITE_KEY, VITE_PUBLIC_POSTHOG_*\nMarketing build:   VITE_DASHBOARD_URL = auth host, VITE_API_URL (plan prices)\nAuth service:   AUTH_URL, NEXT_PUBLIC_AUTH_URL, BETTER_AUTH_SECRET, DATABASE_URL,\n                Google, Stripe, Turnstile, Resend, Supabase\nAPI service:   AUTH_URL (issuer + JWKS), DATABASE_URL, DIRECT_URL, STUDIO_URL,\n                MCP_RESOURCE_URL, CRON_SECRET, FCM_*, AI_SETTINGS_ENCRYPTION_KEY\nFlutter:   --dart-define HOSANNA_AUTH_URL, captcha page on the auth host\nRedis Cloud URL: set on auth + API (variable name is not in the repo yet)", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Studio build:   VITE_API_URL, VITE_AUTH_URL, VITE_TURNSTILE_SITE_KEY, VITE_PUBLIC_POSTHOG_*\nMarketing build:   VITE_DASHBOARD_URL = auth host, VITE_API_URL (plan prices)\nAuth service:   AUTH_URL, NEXT_PUBLIC_AUTH_URL, BETTER_AUTH_SECRET, DATABASE_URL,\n                Google, Stripe, Turnstile, Resend, Supabase\nAPI service:   AUTH_URL (issuer + JWKS), DATABASE_URL, DIRECT_URL, STUDIO_URL,\n                MCP_RESOURCE_URL, CRON_SECRET, FCM_*, AI_SETTINGS_ENCRYPTION_KEY\nFlutter:   --dart-define HOSANNA_AUTH_URL, captcha page on the auth host\nRedis Cloud URL: set on auth + API (variable name is not in the repo yet)", "autoResize": true, "lineHeight": 1.25}, {"id": "re52", "type": "rectangle", "x": 1130, "y": 1120, "width": 400, "height": 330, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 40, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 431613002, "version": 1, "versionNonce": 45313732, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "tx53", "type": "text", "x": 1146, "y": 1130, "width": 194.4, "height": 22.5, "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent", "fillStyle": "solid", "stro