      "versionNonce": 563858119,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794358926142,
      "link": null,
      "locked": false,
      "text": "Small canvas (up to about 700 KB):\n  bytes are inlined in the Firestore doc,\n  clients apply them from the snapshot.\n\nLarge canvas:\n  Firestore keeps metadata only\n  (payloadLocation: api, revision).\n  Bytes come from Postgres over REST.\n\nText notes: always Postgres,\n  Firestore only holds a tiny ping.\n\nNeither is part of replication.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Small canvas (up to about 700 KB):\n  bytes are inlined in the Firestore doc,\n  clients apply them from the snapshot.\n\nLarge canvas:\n  Firestore keeps metadata only\n  (payloadLocation: api, revision).\n  Bytes come from Postgres over REST.\n\nText notes: always Postgres,\n  Firestore only holds a tiny ping.\n\nNeither is part of replication.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aU"
    },
