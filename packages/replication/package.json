{
  "name": "@hosanna/replication",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local-first IndexedDB engine and configurable HTTP replication for Hosanna",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./engine": {
      "types": "./src/engine/index.ts",
      "default": "./src/engine/index.ts"
    },
    "./replication": {
      "types": "./src/replication/index.ts",
      "default": "./src/replication/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@hosanna/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
