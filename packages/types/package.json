{
  "name": "@hosanna/types",
  "version": "1.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Hosanna REST API contract: OpenAPI spec and generated TypeScript types",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/schema.ts && prettier --write src/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hosanna/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.3",
    "typescript": "catalog:"
  }
}
