{
  "name": "@hosanna/i18n",
  "version": "1.0.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Hosanna UI language model: supported languages, locale resolution, and typed dictionary helpers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./messages": {
      "types": "./src/messages/index.ts",
      "default": "./src/messages/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@hosanna/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
