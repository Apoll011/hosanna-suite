{
  "name": "@hosanna/analytics",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Modular telemetry, error tracking, and feature flags for Hosanna Suite",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint --config ../config/eslint.config.js ."
  },
  "dependencies": {
    "posthog-js": "^1.450.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hosanna/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "eslint": "^9.32.0"
  }
}
