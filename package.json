{
  "name": "hosanna-suite",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "turbo run format",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @hosanna/db db:generate",
    "db:migrate": "pnpm --filter @hosanna/db db:migrate",
    "db:migrate:dev": "pnpm --filter @hosanna/db db:migrate:dev",
    "db:push": "pnpm --filter @hosanna/db db:push"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
