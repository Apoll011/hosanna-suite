{
  "name": "hosanna-suite",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:workspace": "node --test scripts/workspace-health.test.mjs",
    "clean": "turbo run clean",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "fix:tailwind": "node ./scripts/fix-tailwind.mjs",
    "fix:eslint": "turbo run fix --continue",
    "fix": "pnpm run fix:tailwind; pnpm run fix:eslint; pnpm run format",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @hosanna/db db:generate",
    "db:migrate": "pnpm --filter @hosanna/db db:migrate",
    "db:migrate:dev": "pnpm --filter @hosanna/db db:migrate:dev",
    "db:push": "pnpm --filter @hosanna/db db:push",
    "openapi:generate": "node ./scripts/generate-openapi.mjs && pnpm --filter @hosanna/types generate"
  },
  "prettier": "./packages/config/prettier.json",
  "devDependencies": {
    "@tailwindcss/language-server": "^0.16.0",
    "prettier": "^3.7.3",
    "tailwint": "^1.1.16",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "yaml": "^2.9.1"
  }
}
